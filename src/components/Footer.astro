---
import SocialIcon from "./SocialIcon.astro";
import Wordmark from "./Wordmark.astro";
import { contact, footer, nav, site } from "../content/site";

const year = new Date().getFullYear();
---

<footer class="stars relative px-5 py-14 sm:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 text-center lg:grid-cols-3 lg:items-start lg:text-left">
      <div>
        <Wordmark size="md" class="mx-auto lg:mx-0" />
        <p class="mx-auto mt-4 max-w-sm text-sm leading-relaxed text-ink-soft lg:mx-0">
          {footer.note}
        </p>
      </div>

      {/* Посередині — навігація рядком, без заголовка, і соцмережі під нею */}
      <div class="flex flex-col items-center gap-5">
        <nav aria-label="Розділи сайту">
          <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm font-semibold hover:underline">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <ul class="flex items-center justify-center gap-2.5">
          {contact.socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="grid h-11 w-11 place-items-center rounded-full bg-paper-deep transition-transform duration-300 ease-bounce hover:-translate-y-0.5 hover:bg-honey"
              >
                <SocialIcon name={social.label} class="h-5 w-5" />
                <span class="sr-only">{social.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:text-right">
        <h2 class="text-base font-bold">Зв'язок</h2>
        <a
          href={`mailto:${contact.email}`}
          class="mt-3 inline-block text-sm text-ink-soft hover:text-ink hover:underline"
        >
          {contact.email}
        </a>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center gap-4 border-t border-ink/10 pt-6 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <p class="text-sm text-ink-soft">
        © {year} {site.name}
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {footer.legal.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-ink-soft hover:text-ink hover:underline">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
