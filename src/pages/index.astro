---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import About from "../sections/About.astro";
import Apps from "../sections/Apps.astro";
import Careers from "../sections/Careers.astro";
import Contact from "../sections/Contact.astro";
import Games from "../sections/Games.astro";
import Hero from "../sections/Hero.astro";
import Highlights from "../sections/Highlights.astro";
---

<Layout>
  <a
    href="#main"
    class="sr-only rounded-full bg-honey px-5 py-2.5 font-bold focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60]"
  >
    Перейти до вмісту
  </a>

  <Header />

  <main id="main">
    <Hero />
    <Highlights />
    <Apps />
    <Games />
    <About />
    <Careers />
    <Contact />
  </main>

  <Footer />
</Layout>
