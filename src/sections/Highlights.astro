---
import { Image } from "astro:assets";

import Section from "../components/Section.astro";
import { art } from "../content/images";
import { highlights } from "../content/site";
---

<Section tone="sky">
  <header class="mx-auto max-w-2xl text-center">
    <h2 class="text-[clamp(1.9rem,4.5vw,3.25rem)]">Що в роботі</h2>
    <p class="mt-3 text-lg">Ігри, які малюємо просто зараз</p>
  </header>

  <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {highlights.map((item, i) => (
      <li
        class="reveal reveal-card card flex flex-col bg-white p-4"
        style={`transition-delay:${i * 80}ms`}
      >
        <Image
          src={art(item.cover)}
          alt=""
          widths={[320, 640]}
          sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 90vw"
          class="block aspect-[4/3] w-full rounded-[1.25rem] object-cover"
        />

        <div class="flex flex-1 flex-col px-2 pt-5 pb-2">
          <h3 class="text-lg">{item.title}</h3>
          <p class="mt-2.5 text-[0.95rem] leading-relaxed text-ink-soft">{item.text}</p>
        </div>
      </li>
    ))}
  </ul>
</Section>
