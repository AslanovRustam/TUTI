---
import { Image } from "astro:assets";

import Section from "../components/Section.astro";
import { art } from "../content/images";
import { about } from "../content/site";
---

<Section id="about">
  <h2 class="mx-auto max-w-3xl text-center text-[clamp(1.9rem,4.5vw,3.25rem)]">{about.title}</h2>

  {/* Бенто: велика ілюстрація, під нею — пункти на підкладках */}
  <div class="mt-12 grid gap-4">
    <div class="overflow-hidden rounded-[2rem]">
      <Image
        src={art(about.cover)}
        alt={about.coverAlt}
        widths={[640, 960, 1280, 1672]}
        sizes="(min-width: 1280px) 1280px, 96vw"
        class="block w-full"
      />
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {about.values.map((value) => (
        <li class="rounded-[1.5rem] bg-paper-deep p-6">
          <h3 class="text-lg">{value.title}</h3>
          <p class="mt-2.5 leading-relaxed text-ink-soft">{value.text}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-12 max-w-4xl space-y-5">
    <p class="text-[clamp(1.15rem,2.2vw,1.5rem)] leading-snug font-bold">{about.lead}</p>
    {about.story.map((para) => (
      <p class="text-lg leading-relaxed font-semibold text-ink-soft">{para}</p>
    ))}
  </div>
</Section>
