---
import { Image } from "astro:assets";

import Button from "../components/Button.astro";
import { art } from "../content/images";
import { hero } from "../content/site";

const cover = art(hero.cover);
---

<section id="top" class="stars relative px-5 pt-32 pb-16 sm:px-8 sm:pt-40 sm:pb-24">
  <h1 class="mx-auto max-w-5xl text-center text-[clamp(3.1rem,9.5vw,6.6rem)]">{hero.title}</h1>

  <div class="mx-auto mt-14 max-w-6xl overflow-hidden rounded-[2.5rem]">
    <Image
      src={cover}
      alt={hero.coverAlt}
      widths={[640, 960, 1280, 1672]}
      sizes="(min-width: 1280px) 1152px, 94vw"
      class="block w-full"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  {/* Під картинкою: текст ліворуч, кнопки праворуч */}
  <div class="mx-auto mt-10 flex max-w-6xl flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
    <p class="max-w-2xl text-[clamp(1.15rem,2.4vw,1.6rem)] leading-snug font-bold">{hero.lead}</p>

    <div class="flex shrink-0 flex-wrap items-center gap-3">
      <Button href={hero.primary.href} size="lg">
        {hero.primary.label}
      </Button>
      <Button href={hero.secondary.href} variant="paper" size="lg">
        {hero.secondary.label}
      </Button>
    </div>
  </div>
</section>
